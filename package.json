{
  "name": "missao-proteja-seus-dados",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "http-server docs -a 127.0.0.1 -p 4173 -c-1",
    "preview:prefix": "http-server . -a 127.0.0.1 -p 4174 -c-1",
    "test": "node --test tests/unit/*.test.js tests/content/*.test.js",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.js",
    "test:budget": "node --test tests/content/budget.test.js && playwright test tests/e2e/performance.spec.js --project=chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "http-server": "14.1.1"
  }
}
